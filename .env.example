# Optional overrides for docker-compose.yml (local development only).
# Copy to .env and adjust. .env is git-ignored. Do NOT put production credentials here.

# SQL Server 'sa' password (must meet SQL Server complexity rules; avoid ';' and quotes).
MSSQL_SA_PASSWORD=GameCore_Local_2026!

# JWT signing key: at least 32 characters. Must NOT start with CHANGE-ME when
# ASPNETCORE_ENVIRONMENT=Production.
GAMECORE_JWT_KEY=CHANGE-ME-LOCAL-ONLY-GameCore-Docker-2026-Development-Key-64Chars
ASPNETCORE_ENVIRONMENT=Development

# Host ports
SQL_PORT=1433
API_PORT=8080
FRONTEND_PORT=5173
